# Copy this file to .env and fill in your keys. Never commit .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
# Each agent gets its own bank: <prefix>-dispatcher, -diagnostician, -parts, -field
HINDSIGHT_BANK_PREFIX=sitememory-v2
HINDSIGHT_BANK_ID=sitememory-v2-field

# Band (band.ai) coordination layer. In the Band app: Agents > Connect remote agent, once per agent below,
# and paste each agent's API key (shown once). Leave empty to run the same agents in-process.
BAND_BASE_URL=https://app.band.ai/api/v1
BAND_KEY_DISPATCHER=
BAND_KEY_DIAGNOSTICIAN=
BAND_KEY_PARTS=
BAND_KEY_FIELD=
