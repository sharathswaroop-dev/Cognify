# Copy this file to .env and fill in your keys. Never commit .env.
GROQ_API_KEY=
# Failover chain: each model has its own daily token budget, so a rate limit moves on to the next one.
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
# One bank per company. Every agent reads and writes this single shared bank.
HINDSIGHT_BANK_ID=sitememory-v3-coolcare

# Band (band.ai) coordination layer. In the Band app: Agents > Connect remote agent, once per agent below,
# and paste each agent's API key (shown once). Leave empty to run the same agents in-process.
BAND_BASE_URL=https://app.band.ai/api/v1
BAND_KEY_DISPATCHER=
BAND_KEY_DIAGNOSTICIAN=
BAND_KEY_PARTS=
BAND_KEY_VERIFIER=
